from waflib import Utils
import os

top = '.'
PROJECT_NAME = 'video_bink'

def options(opt):
	# stub
	return

def configure(conf):
	return

def build(bld):
	if bld.env.DEST_OS == 'win32':
		return

	# ffmpeg prebuilts only ship for aarch64 on android, so bink can't be linked
	# for 32 bit (lib/android/arm has no libav*). It is loaded on demand by
	# video_services, so simply leaving it out is fine.
	if bld.env.DEST_OS == 'android' and not os.path.exists(
			os.path.join(bld.top_dir, 'lib', 'android', bld.env.DEST_CPU, 'libavcodec.so')):
		return

	source = [
		'bink_video.cpp',
		'bink_material.cpp',
		'yuv_rgb.c'
	]

	includes = [
		'.',
		'../../public',
		'../../public/tier0',
		'../../public/tier1',
		'../../common',
		'../'
	] + bld.env.INCLUDES_SDL2
	if bld.env.DEST_OS == 'android':
		includes += [
			'../../ffmpeg/'+bld.env.DEST_CPU+'/']
	defines = []
	bld.env.LIB = ['avutil', 'avformat', 'avcodec']
	libs = ['tier0','tier1','tier2','tier3','vstdlib', 'AVCODEC', 'AVUTIL', 'AVFORMAT']

	if bld.env.DEST_OS == 'win32':
		libs += ['USER32']

	install_path = bld.env.LIBDIR

	if True:  #not bld.env.DEST_OS == 'android':
		bld.shlib(
			source   = source,
			target   = PROJECT_NAME,
			name     = PROJECT_NAME,
			features = 'c cxx',
			includes = includes,
			defines  = defines,
			use      = libs,
			install_path = install_path,
			subsystem = bld.env.MSVC_SUBSYSTEM,
			idx      = bld.get_taskgen_count()
		)

