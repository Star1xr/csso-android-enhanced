<rml>
	<head>
		<title>hud_scoreboard</title>
		<link type="text/rcss" href="styles/csso.rcss"/>
		<style>
			body { width: 100%; height: 100%; pointer-events: none; }
			#sb { position: absolute; left: 50%; top: 8%; width: 960px; margin-left: -480px; padding: 12px 0; background-color: #0c0f12e0; }
			.head { display: block; height: 56px; line-height: 56px; font-size: 36px; text-align: center; }
			.head .ct { color: #6aa9ff; margin-right: 40px; }
			.head .t { color: #e0a24a; margin-left: 40px; }
			.head .vs { color: #8b949e; }
			.cols, .row { display: block; height: 34px; line-height: 34px; font-size: 22px; padding: 0 20px; }
			.cols { color: #8b949e; font-size: 18px; }
			.row.me { background-color: #ffffff22; }
			.row.dead { color: #6b737b; }
			.n { display: inline-block; width: 440px; overflow: hidden; }
			.v { display: inline-block; width: 90px; text-align: right; }
			.section { display: block; margin-top: 6px; }
			.ct.title { color: #6aa9ff; }
			.t.title { color: #e0a24a; }
			.title { display: block; font-size: 22px; padding: 4px 20px; }
			#spec { display: block; padding: 6px 20px; font-size: 18px; color: #8b949e; }
		</style>
	</head>
	<body>
		<div id="sb">
			<div class="head"><span class="ct" id="ct_score">0</span><span class="vs">-</span><span class="t" id="t_score">0</span></div>
			<div class="cols"><span class="n">PLAYER</span><span class="v">K</span><span class="v">A</span><span class="v">D</span><span class="v">SCORE</span><span class="v">PING</span></div>
			<span class="ct title">COUNTER-TERRORISTS</span>
			<div id="ct_rows"></div>
			<span class="t title">TERRORISTS</span>
			<div id="t_rows"></div>
			<div id="spec"></div>
		</div>
	</body>
</rml>
