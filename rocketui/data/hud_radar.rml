<rml>
	<head>
		<title>hud_radar</title>
		<link type="text/rcss" href="styles/csso.rcss"/>
		<style>
			body { width: 100%; height: 100%; pointer-events: none; }
			#radar { position: absolute; left: 18px; top: 18px; width: 260px; height: 260px; background-color: #0c0f12b3; border-radius: 130px; }
			#me { position: absolute; left: 125px; top: 125px; width: 10px; height: 10px; background-color: #ffffff; border-radius: 5px; }
			.dot { position: absolute; width: 12px; height: 12px; border-radius: 6px; background-color: #4b8bff; }
			.dot.off { display: none; }
			.dot.friend { background-color: #4b8bff; }
			.dot.foe { background-color: #ff4d4d; }
			.dot.spec_t { background-color: #e0a24a; }
			.dot.spec_ct { background-color: #6aa9ff; }
			.dot.carrier { background-color: #ff4d4d; border-width: 2px; border-color: #ffcf4d; }
			.dot.bomb_planted { background-color: #ff2a2a; border-radius: 0; width: 14px; height: 14px; }
			.dot.bomb_dropped { background-color: #ffcf4d; border-radius: 0; }
			.dot.hostage { background-color: #8fd18f; border-radius: 0; width: 10px; height: 10px; }
			.dot.up { opacity: 0.6; }
			.dot.down { opacity: 0.35; }
		</style>
	</head>
	<body>
		<div id="radar"><div id="me"></div></div>
	</body>
</rml>
