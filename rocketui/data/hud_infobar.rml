<rml>
	<head>
		<title>hud_infobar</title>
		<link type="text/rcss" href="styles/csso.rcss"/>
		<style>
			body { width: 100%; height: 100%; pointer-events: none; }
			.box { position: absolute; bottom: 18px; height: 70px; padding: 0 22px; background-color: #0c0f12b3; }
			.num { font-size: 48px; line-height: 70px; color: #ffffff; }
			.lbl { font-size: 20px; color: #8b949e; margin-left: 6px; }
			#left { left: 18px; }
			#right { right: 18px; text-align: right; }
			#money { position: absolute; right: 18px; bottom: 98px; padding: 4px 16px; background-color: #0c0f12b3; font-size: 34px; color: #8fd18f; }
			#flags { position: absolute; left: 18px; bottom: 98px; font-size: 22px; color: #d9a441; }
			#weapon { font-size: 22px; color: #8b949e; text-transform: uppercase; }
			.low { color: #ff5a4d; }
			#reserve { font-size: 28px; color: #8b949e; }
		</style>
	</head>
	<body>
		<div id="flags"></div>
		<div id="money"></div>
		<div id="left" class="box">
			<span class="num" id="hp">100</span><span class="lbl">HP</span>
			<span class="num" id="armor" style="margin-left: 26px;">0</span><span class="lbl" id="armor_lbl">AR</span>
		</div>
		<div id="right" class="box">
			<span id="weapon"></span>
			<span class="num" id="clip"></span><span class="lbl" id="reserve"></span>
		</div>
	</body>
</rml>
