/* CS:SO RocketUI base style. Plain colours only (no spritesheets), RmlUi 5.1. */

body, div, p, h1, h2, h3, form, br
{
	display: block;
}
br { height: 0; }
b, strong { font-weight: bold; }

body
{
	font-family: Lato;
	font-size: 22px;
	color: #e6e6e6;
}

h1 { font-size: 34px; margin-bottom: 6px; color: #ffffff; }
h2 { font-size: 24px; margin: 14px 0 6px 0; color: #d9a441; }
.muted { color: #8b949e; font-size: 18px; }

/* Buttons: big enough for fingers. */
.btn
{
	display: block;
	box-sizing: border-box;
	width: 100%;
	height: 58px;
	line-height: 58px;
	margin-bottom: 8px;
	padding: 0 22px;
	background-color: #262c33;
	border-left-width: 4px;
	border-left-color: #d9a441;
	color: #ffffff;
	text-align: left;
	cursor: pointer;
}
.btn:hover { background-color: #34404c; }
.btn:active { background-color: #d9a441; color: #14181c; }
.btn.small { display: inline-block; width: 190px; height: 48px; line-height: 48px; margin-right: 10px; text-align: center; }

/* Dropdowns */
select
{
	display: inline-block;
	position: relative;
	box-sizing: border-box;
	width: 300px;
	height: 46px;
	line-height: 46px;
	margin-bottom: 14px;
	background-color: #1b2025;
	border-width: 1px;
	border-color: #4a5560;
	color: #ffffff;
	cursor: pointer;
}
select selectvalue
{
	display: block;
	padding: 0 12px;
	margin-right: 40px;
}
select selectarrow
{
	display: block;
	position: absolute;
	top: 0;
	right: 0;
	width: 40px;
	height: 46px;
	background-color: #2f3842;
}
select selectarrow:hover { background-color: #d9a441; }
select selectbox
{
	background-color: #1b2025;
	border-width: 1px;
	border-color: #4a5560;
	max-height: 320px;
	overflow-y: auto;
	z-index: 100;
}
select selectbox option
{
	display: block;
	padding: 0 12px;
	height: 46px;
	line-height: 46px;
	color: #e6e6e6;
}
select selectbox option:hover { background-color: #34404c; }
select selectbox option:checked { background-color: #d9a441; color: #14181c; }

/* Sliders */
input.range
{
	display: inline-block;
	box-sizing: border-box;
	width: 300px;
	height: 46px;
	margin-bottom: 14px;
}
input.range slidertrack
{
	height: 10px;
	margin-top: 18px;
	background-color: #000000;
	border-width: 1px;
	border-color: #4a5560;
}
input.range sliderbar
{
	width: 26px;
	height: 38px;
	margin-top: -14px;
	background-color: #d9a441;
}
input.range sliderbar:hover { background-color: #f0c060; }
input.range sliderarrowdec, input.range sliderarrowinc { width: 0; height: 0; display: none; }

KisakConvarSettingEnum, KisakConvarSettingSlider
{
	display: block;
	margin-bottom: 4px;
}
