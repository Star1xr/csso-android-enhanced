<rml>
	<head>
		<title>menu_loading</title>
		<link type="text/rcss" href="styles/csso.rcss"/>
		<style>
			body { width: 100%; height: 100%; background-color: #0d1014; }
			#box { position: absolute; left: 10%; right: 10%; bottom: 14%; }
			#map { display: block; font-size: 44px; color: #ffffff; margin-bottom: 8px; }
			#status { display: block; font-size: 22px; color: #8b949e; margin-bottom: 14px; }
			#bar { height: 10px; background-color: #2a323a; }
			#fill { width: 0%; height: 10px; background-color: #d9a441; }
		</style>
	</head>
	<body>
		<div id="box">
			<span id="map"></span>
			<span id="status">Loading</span>
			<div id="bar"><div id="fill"></div></div>
		</div>
	</body>
</rml>
