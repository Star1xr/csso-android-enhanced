<rml>
	<head>
		<title>hud_pausemenu</title>
		<link type="text/rcss" href="styles/csso.rcss"/>
		<style>
			body { width: 100%; height: 100%; pointer-events: none; }
			#dim { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: #000000aa; pointer-events: auto; }
			#panel { position: absolute; left: 50%; top: 50%; width: 460px; margin-left: -230px; margin-top: -210px; padding: 24px 28px; background-color: #14181cf5; pointer-events: auto; }
			.title { display: block; font-size: 34px; color: #ffffff; margin-bottom: 16px; }
			.btn { height: 64px; line-height: 64px; font-size: 26px; margin-bottom: 10px; }
			.btn.danger { background-color: #4a2220; }
		</style>
	</head>
	<body>
		<div id="dim"></div>
		<div id="panel">
			<span class="title">Paused</span>
			<button id="pm_resume" class="btn">Resume</button>
			<button id="pm_team" class="btn">Choose team</button>
			<button id="pm_options" class="btn">Options</button>
			<button id="pm_disconnect" class="btn danger">Disconnect</button>
		</div>
	</body>
</rml>
